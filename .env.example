# ============================================================
# AI Persona — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Persona ---
PERSONA_NAME="Abinash"
PERSONA_TAGLINE="AI Engineer & Solutions Architect"

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub ---
# Personal access token (optional, increases rate limit to 5000/hr)
GITHUB_TOKEN=your_github_token_here
# Comma-separated list of repos to ingest: owner/repo,owner/repo2
GITHUB_REPOS=yourusername/repo1,yourusername/repo2,yourusername/repo3
# Your GitHub username (used to fetch all public repos if GITHUB_REPOS is empty)
GITHUB_USERNAME=yourusername

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=ai_persona

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- RAG ---
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
CONVERSATION_MEMORY_WINDOW=10

# --- Cal.com ---
CALCOM_API_KEY=your_calcom_api_key_here
CALCOM_EVENT_TYPE_SLUG=30min
CALCOM_USERNAME=your_calcom_username

# --- LiveKit ---
LIVEKIT_URL=wss://your-livekit-cloud-url.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# --- Deepgram (STT) ---
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# --- Frontend ---
STREAMLIT_PORT=8501

# --- Logging ---
LOG_LEVEL=INFO
